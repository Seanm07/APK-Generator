<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ApkGenerator.Mac.Controls"
             x:Class="ApkGenerator.Mac.Controls.SecretBox">
    <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="Box" PasswordChar="●" VerticalContentAlignment="Center" MinHeight="32" />

        <!-- eye while hidden, slashed eye while visible -->
        <Button x:Name="Reveal" Grid.Column="1" Classes="icon" Click="Reveal_Click"
                ToolTip.Tip="Show password" AutomationProperties.Name="Show password">
            <c:Icon x:Name="EyeIcon" Kind="eye" Width="18" Height="18" />
        </Button>
    </Grid>
</UserControl>
