<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApkGenerator.Mac.DependencyWindow"
        Title="Some tools are missing" Width="660" SizeToContent="Height" MaxHeight="820" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="26,22,26,22" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Some tools are missing" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Margin="0,4,0,0"
                       Text="APK Generator still opens, but the features below won't work until these are installed." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Missing}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource ErrorTintBrush}" CornerRadius="9" Padding="9,1" VerticalAlignment="Center">
                                        <TextBlock Text="Not found" FontSize="11.5" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Classes="label" Margin="0,12,0,2" Text="What won't work" />
                                <TextBlock Text="{Binding WhatWontWork}" TextWrapping="Wrap" />

                                <TextBlock Classes="label" Margin="0,12,0,2" Text="How to fix it" />
                                <TextBlock Text="{Binding HowToFix}" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding Links}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}" Tag="{Binding Url}" Click="Link_Click"
                                                    ToolTip.Tip="{Binding Url}" Padding="14,5" Margin="0,0,8,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Classes="muted" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="RetryButton" Content="Retry" Classes="accent" Padding="30,7" Click="Retry_Click"
                        IsEnabled="{Binding CanRetry}" ToolTip.Tip="Look for the tools again (use this after installing them)"
                        AutomationProperties.AutomationId="RetryButton" />
                <Button x:Name="ContinueButton" Content="Continue Anyway" Padding="22,7" Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
