<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ApkGenerator</AssemblyName>
    <RootNamespace>ApkGenerator.App</RootNamespace>
    <Version>12.0.0</Version>
    <!-- Shown in Task Manager / file properties -->
    <Product>APK Generator</Product>
    <AssemblyTitle>APK Generator</AssemblyTitle>
    <Description>APK Generator</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The WPF Fluent theme (ThemeMode) is still flagged experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="Exists('app.ico')">
    <Resource Include="app.ico" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApkGenerator.Core\ApkGenerator.Core.csproj" />
  </ItemGroup>

</Project>
