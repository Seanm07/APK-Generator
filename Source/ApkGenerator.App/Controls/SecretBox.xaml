<UserControl x:Class="ApkGenerator.App.Controls.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <PasswordBox x:Name="Hidden" PasswordChanged="Hidden_PasswordChanged" VerticalContentAlignment="Center" />
        <TextBox x:Name="Shown" Visibility="Collapsed" TextChanged="Shown_TextChanged" VerticalContentAlignment="Center" />

        <!-- The icon is drawn with shapes (an eye, plus a slash while the password is visible) so it doesn't
             depend on any icon font: the "hide" glyph used before doesn't exist in Windows 10's font. -->
        <Button x:Name="Reveal" Grid.Column="1" MinWidth="38" MinHeight="32" Margin="8,0,0,0" Padding="0"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                AutomationProperties.Name="Show password" ToolTip="Show password" Click="Reveal_Click">
            <Viewbox Width="18" Height="18" Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Path Data="M1.5,10 C4,5.2 7,3.6 10,3.6 C13,3.6 16,5.2 18.5,10 C16,14.8 13,16.4 10,16.4 C7,16.4 4,14.8 1.5,10 Z"
                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="6" Height="6"
                             Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                    <Line x:Name="Slash" X1="3" Y1="17.5" X2="17" Y2="2.5" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
