<Window x:Class="ApkGenerator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ApkGenerator.App.Controls"
        Title="Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="FTP upload" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                   Text="Fill in the server to show a “Save APK to FTP” button next to Save APK. Leave the server blank to hide it." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Server" />
                <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="For example ftp.example.com" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Username  (leave blank for anonymous)" Margin="0,14,0,4" />
        <TextBox x:Name="UserBox" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Password" Margin="0,14,0,4" />
        <c:SecretBox Secret="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="FTP path  (folder on the server to upload into)" Margin="0,14,0,4" />
        <TextBox x:Name="FolderBox" Text="{Binding RemoteFolder, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="For example /builds/android. The folder is created if it doesn't exist." />

        <CheckBox x:Name="TlsCheck" IsChecked="{Binding UseTls}" Content="Use TLS (FTPS)" Margin="0,14,0,0"
                  ToolTip="Encrypts the connection. Only works if the server supports it." />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="TestButton" Content="Test connection" Click="Test_Click" Padding="16,6"
                    IsEnabled="{Binding CanTest}" />
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" FontSize="12.5"
                       Text="{Binding TestMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0.75" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TestIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TestIsOk}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TextBlock Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="{Binding ValidationError}"
                   Visibility="{Binding ValidationError, Converter={StaticResource HasValueVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" Padding="28,7"
                    Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Padding="22,7" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
