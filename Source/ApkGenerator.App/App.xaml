<Application x:Class="ApkGenerator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ApkGenerator.App"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Semi-transparent neutrals read correctly on both the light and dark Fluent themes. -->
            <SolidColorBrush x:Key="CardBrush" Color="#14808080" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#33808080" />
            <SolidColorBrush x:Key="DividerBrush" Color="#26808080" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8C8C8C" />
            <SolidColorBrush x:Key="PillBrush" Color="#1F808080" />

            <SolidColorBrush x:Key="AccentBrush" Color="#2F80ED" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#C98A00" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#262F80ED" />
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#1F2EA043" />
            <SolidColorBrush x:Key="ErrorTintBrush" Color="#1FE5484D" />
            <SolidColorBrush x:Key="WarningTintBrush" Color="#26C98A00" />

            <local:BoolToVisibilityConverter x:Key="BoolVis" />
            <local:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
            <local:HasValueToVisibilityConverter x:Key="HasValueVis" />
            <local:HasValueToVisibilityConverter x:Key="NoValueVis" Invert="True" />
            <local:InverseBoolConverter x:Key="InvertBool" />
            <local:StatusKindConverter x:Key="StatusKindConv" />
            <local:RowStateConverter x:Key="RowStateConv" />

            <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.68" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.68" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="FactValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="IconText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="22,9" />
            </Style>

            <!-- Square icon button that is as tall as the box beside it (stretches to the row height). -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
