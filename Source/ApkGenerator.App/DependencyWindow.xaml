<Window x:Class="ApkGenerator.App.DependencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Some tools are missing" Width="660" SizeToContent="Height" MaxHeight="820"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Some tools are missing" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="APK Generator still opens, but the features below won't work until these are installed." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Missing}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource ErrorTintBrush}" CornerRadius="9" Padding="9,1" Margin="10,2,0,0">
                                        <TextBlock Text="Not found" FontSize="11.5" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,2" Text="What won't work" />
                                <TextBlock Text="{Binding WhatWontWork}" TextWrapping="Wrap" />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,2" Text="How to fix it" />
                                <TextBlock Text="{Binding HowToFix}" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding Links}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}" Tag="{Binding Url}" Click="Link_Click"
                                                    ToolTip="{Binding Url}" Padding="14,5" Margin="0,0,8,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource PrimaryButton}" Padding="30,7"
                        Click="Retry_Click" IsEnabled="{Binding CanRetry}"
                        ToolTip="Look for the tools again (use this after installing them)" />
                <Button x:Name="ContinueButton" Content="Continue Anyway" Padding="22,7" Margin="10,0,0,0" Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
